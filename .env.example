# Génère une clé dans Mistral Studio puis colle-la ici dans TON fichier .env local.
# Ne commit jamais .env ni une vraie clé API.
MISTRAL_API_KEY=your_mistral_api_key_here

# Modèle par défaut pour les premières requêtes.
MISTRAL_MODEL=mistral-small-latest

# Endpoint officiel Mistral.
MISTRAL_BASE_URL=https://api.mistral.ai

# Gandalf peut faire plusieurs appels pour une seule tentative aux niveaux avancés.
# Ce pacing évite de les envoyer en rafale sur le free tier.
MISTRAL_MIN_INTERVAL_SECONDS=1.1

# Nombre de retries après un HTTP 429. Le client respecte Retry-After s'il est fourni.
MISTRAL_MAX_RETRIES=1
